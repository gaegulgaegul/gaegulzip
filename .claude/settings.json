{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"작업 완료\" with title \"Claude Code\" sound name \"Glass\"'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/auto-validate.sh",
            "timeout": 30000
          },
          {
            "type": "command",
            "command": ".claude/hooks/sql-injection-check.sh",
            "timeout": 10000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/context-enrichment.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/context-recovery.sh",
            "timeout": 10000
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "bkit@bkit-marketplace": true,
    "coderabbit@claude-plugins-official": false,
    "claude-mem@thedotmack": true,
    "frontend-design@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": false,
    "code-architect@cc-marketplace": false,
    "codebase-documenter@cc-marketplace": false,
    "code-refactoring@claude-code-workflows": false,
    "test-writer-fixer@cc-marketplace": false,
    "context7@claude-plugins-official": true,
    "interactive-review@team-attention-plugins": true,
    "playwright@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true
  },
  "plugins": {
    "autoUpdate": true
  }
}
